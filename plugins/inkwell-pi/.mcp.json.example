{
  "mcpServers": {
    "inkwell": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-v", "${HOME}/.inkwell/knowledge:/knowledge", "foreigndmitryi/inkwell"],
      "directTools": ["search", "recall", "remember", "list", "tags", "forget", "rebuild", "doctor"],
      "lifecycle": "lazy"
    }
  }
}
